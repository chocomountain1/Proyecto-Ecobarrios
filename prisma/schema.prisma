generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL)
}

model Ecobarrio{
  id  Int @id @default(autoincrement())
  nombre  String
  comuna  String
  descripcion   String?
  nombre_contacto   String?
  telefono_contacto   String?
  lat    Int
  lon    Int
  desafios  Desafio[]
}

model Desafio{
  id Int @id @default(autoincrement())
  desafio_particular  String
  tema_interes  String
  ecobarrioId   Int
  ecobarrio   Ecobarrio @relation(fields: [ecobarrioId], references: [id])
  problemas   Problema[]
}

model Problema{
  id  Int @id @default(autoincrement())
  usuarios  String
  descripcion   String
  
}