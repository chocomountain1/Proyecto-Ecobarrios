// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL)
}

model Ecobarrio{
  id  Int @id @default(autoincrement())
  nombre String
  comuna String
  descripcion String?
  nombre_contacto?
  telefono_contacto?
  lat    Int
  lon    Int
  desafios Desafio[]
}