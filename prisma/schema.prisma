// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL)
}

model Ecobarrio{
  id  Int @id @default(autoincrement())
  nombre  String
  comuna  String
  descripcion   String?
  nombre_contacto   String?
  telefono_contacto   String?
  lat    Int
  lon    Int
  desafios  Desafio[]
}

model Desafio{
  id Int @id @default(autoincrement())
  desafio_particular  String
  tema_interes  String
  ecobarrioId   Int @unique
  ecobarrio   Ecobarrio @relation(fields: [ecobarrioId], references: [id])
  problemas   Problema[]
  ods         ODS[]
}

model Problema{
  id  Int @id @default(autoincrement())
  usuarios  String
  descripcion   String
  desafioId   Int @unique
  desafio   Desafio @relation(fields: [desafioId], references: [id])
  ods         ODS[]
  equipos_desarrolladores   Equipo_desarrollador[]
}

model Solucion{
  id  Int @id @default(autoincrement())
  propuesta_solucion  String
  nombre_proyecto   String
  TRL   Int
  grado_innovacion  String
  SRL   Int
  problemaId  Int @unique
  problema  Problema @relation(fields: [problemaId], references: [id])
}

model ODS{
  id  Int @id @default(autoincrement())
  nombre  String

  problemas   Problema[]
  desafios    Desafio[]
  secciones   Seccion[]
}

model Sustentabilidad{
  solucionId  Int @unique
  odsId       Int @unique
  impacto     String
  intensidad  Int
  alcance     String
  profundidad String
  riesgo      String

  solucion    Solucion @relation(fields: [solucionId], references: [id])
  ods         ODS @relation(fields: [odsId], references: [id])
}

model Equipo_desarrollador{
  id  Int @id @default(autoincrement())
  numero    Int
  nombre    String
  problemaId Int @unique
  problema   Problema @relation(fields: [problemaId], references: [id])
  seccionId  Int @unique
  seccion    Seccion @relation(fields: [seccionId], references: [id])
  estudiantes   Estudiante[]
}

model Estudiante{
  id  Int @id @default(autoincrement())
  nombre  String
  equipo_desarrolladorId  Int @unique
  equipo_desarrollador Equipo_desarrollador @relation(fields: [equipo_desarrolladorId], references: [id])
}

model Seccion{
  id  Int @id @default(autoincrement())
  numero              Int
  titulo              String
  desafio_principal   String
  profesor_a_cargo    String
  año                 Int
  equipos             Equipo_desarrollador[]
  rutas               Ruta_tematica[]
  ods                 ODS[]
}

model Ruta_tematica{
  id    Int @id @default(autoincrement())
  ruta_tematica         String
  departamentos         String
  centros               String
  cursos_relacionados   String
  secciones             Seccion[]
}

model Curso{
  id    Int @id @default(autoincrement())
  nombre        String
  codigo        String 
  impartido_en  String
}